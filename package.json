{
  "name": "studev",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/digest.ts && node scripts/build-collection.mjs && astro build",
    "test:collection": "node --test tests/upload-collection.test.mjs tests/verify-osca-upload.test.mjs",
    "test:platform": "node --test tests/platform-*.test.mjs",
    "check": "astro check",
    "test:markdown": "node --test tests/markdown-render.test.mjs",
    "test:render": "node --test tests/static-mermaid.test.mjs tests/site-output.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "digest": "node scripts/digest.ts",
    "test:campus": "vitest run",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@edgeone/pages-blob": "^0.0.14",
    "@hackmd/js-sequence-diagrams": "^0.0.1-alpha.3",
    "astro": "^7.3.3",
    "flowchart.js": "^1.18.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "mathjax-full": "^3.2.1",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-github-alerts": "^4.2.0",
    "rehype-mathjax": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "^6.1.1",
    "wasm-search": "https://github.com/hicancan/wasm-search/releases/download/v1.0.2/wasm-search-1.0.2.tgz"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/raphael": "^2.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "parse5": "^8.0.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
