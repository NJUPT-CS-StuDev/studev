{
  "name": "studev",
  "type": "module",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:logo": "node scripts/build-logo.mjs",
    "dev": "astro dev",
    "build": "node scripts/server/build.mjs && astro build",
    "test:platform": "node --test src/platform/tests/*.test.mjs",
    "check": "astro check",
    "test:site": "node --test src/site/tests/*.test.mjs",
    "test:browser": "node scripts/smoke/web.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "predigest": "node design/map/generate.mjs",
    "digest": "node scripts/data/digest.ts",
    "data:inputs": "node scripts/data/inputs.ts",
    "data:pull": "node scripts/data/pull.ts",
    "data:publish": "node scripts/data/publish.ts",
    "test:campus": "vitest run --exclude scripts/data/package-facts.test.ts",
    "test:data": "vitest run scripts/data/package-facts.test.ts",
    "golden": "esbuild src/campus/world/parity/generate.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src/campus --loader:.json=json --outfile=node_modules/.cache/parity/generate.mjs --log-level=warning && node node_modules/.cache/parity/generate.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "release": "pwsh scripts/release/release.ps1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@edgeone/pages-blob": "^0.0.17",
    "@local-runtime-mcp/browser-extension": "https://github.com/hicancan/local-runtime-mcp/releases/download/v14.2.0/local-runtime-mcp-web-sdk-14.2.0.tgz",
    "@noble/hashes": "^2.4.0",
    "astro": "^7.4.12",
    "docstream": "https://github.com/hicancan/docstream/releases/download/v0.14.0/docstream-0.14.0.tgz",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wasm-search": "https://github.com/hicancan/wasm-search/releases/download/v6.5.0/wasm-search-6.5.0.tgz",
    "wayfind": "https://github.com/hicancan/wayfind/releases/download/v0.3.1/wayfind-0.3.1.tgz"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "parse5": "^8.0.1",
    "playwright-core": "1.57.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
