---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
const posts = (await getCollection('study')).filter((item) => item.data.status === 'published').sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<SiteLayout title="StuDev" description="StuDev" active="">
  <div class="home">
    <h1>Stu<span>Dev</span></h1>
    <section class="home-section">
      <h2>文章</h2>
      {posts.map((post) => <a class="post-row" href={`/study/${post.id}/`}><h3>{post.data.title}</h3><time>{post.data.type}</time></a>)}
    </section>
  </div>
</SiteLayout>
