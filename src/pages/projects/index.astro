---
import SiteLayout from '../../layouts/SiteLayout.astro';
const projects = [
  { title: 'StuDev', text: '静态学习博客。', status: '建设中' },
  { title: '协作知识图谱', text: '以问题和答案产物为节点的协作工具。', status: '设计中' },
  { title: 'NJUPT Search', text: '校园搜索与信息整理实验。', status: '实验' },
];
---
<SiteLayout title="项目 — StuDev" active="projects">
  <div class="listing"><h1>项目</h1><div class="project-list">{projects.map((project) => <article class="project-row"><h2>{project.title}</h2><p>{project.text}</p><span class="project-status">{project.status}</span></article>)}</div></div>
</SiteLayout>
