---
import SiteLayout from '../site/SiteLayout.astro';
import { PRODUCT_CONFIG } from '../campus/world/product';

const android = PRODUCT_CONFIG.ANDROID_APP;
const runtimeRelease = 'https://github.com/hicancan/local-runtime-mcp/releases/latest';
const clients = [
  {
    id: 'android',
    name: 'Android',
    description: '课表和地图离线可用，桌面小组件显示下一节课，导航时锁屏也能继续。',
    detail: `${android.VERSION} · APK`,
    action: '下载 Android 版',
    href: android.PACKAGE_URL,
    package: true,
    icon: 'M8.5 2.5h7a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Zm2.5 16h2',
  },
  {
    id: 'windows',
    name: 'Windows',
    description: '原生桌面客户端，常驻托盘，桌面卡片显示下一节课，新版本自动更新。',
    detail: `${android.VERSION} · x64`,
    action: '下载 Windows 版',
    href: `/download/windows/studev-${android.VERSION}-windows.zip`,
    package: true,
    icon: 'M3.5 5.5 10.5 4.5v7h-7Zm9-1.3 8-1.2v8.5h-8Zm-9 8.3h7v7l-7-1Zm9 0h8V21l-8-1.2Z',
  },
  {
    id: 'web',
    name: '网页版',
    description: '在手机或电脑的浏览器里打开即用，也可以添加到主屏幕。',
    detail: '始终是最新版',
    action: '打开网页版',
    href: '/',
    package: false,
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z',
  },
];
---
<SiteLayout title="获取 StuDev" description="在 Android、Windows 或浏览器上使用 StuDev。下载 Local Runtime MCP，连接这台电脑上的网页工具。" active="download" noPwa>
  <div class="download-page">
    <header class="download-hero">
      <img class="download-icon" src="/pwa-icons/192.png" srcset="/pwa-icons/192.png 2x, /pwa-icons/512.png 4x" width="72" height="72" alt="" />
      <h1>StuDev</h1>
      <p>南邮的课表、地图、知识、搜索和 AI，放在一起。</p>
      <div class="download-primary" data-download-primary>
        <a class="download-button primary" href={clients[0]!.href} rel="nofollow" data-astro-prefetch="false" data-for="android">{clients[0]!.action}</a>
        <span class="download-version">版本 {android.VERSION}</span>
      </div>
    </header>

    <div class="download-clients">
      {clients.map(client => <article class="download-client" data-client={client.id}>
        <div class="client-head">
          <svg class="client-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={client.icon} /></svg>
          <span class="client-badge" hidden>当前设备</span>
        </div>
        <h2>{client.name}</h2>
        <p>{client.description}</p>
        <div class="client-foot">
          <small>{client.detail}</small>
          <a class="download-button" href={client.href} rel={client.package ? 'nofollow' : undefined} data-astro-prefetch={client.package ? 'false' : undefined}>{client.action}</a>
        </div>
      </article>)}
    </div>

    <div class="download-support">
      <p>在微信或 QQ 里下载 Android 版，请先点右上角，选择「在浏览器打开」。</p>
      <div class="support-links">
        <a href={android.BACKUP_URL} rel="nofollow" data-astro-prefetch="false">Android 备用下载</a>
        <a href={android.RELEASES_URL}>版本记录</a>
        <button class="text-copy" type="button" data-copy-link data-copy-text={`${PRODUCT_CONFIG.ORIGIN}/download/`}><span aria-live="polite" data-copy-label>复制下载页链接</span></button>
      </div>
    </div>

    <section class="desktop-tool" aria-labelledby="desktop-tool-title">
      <div>
        <h2 id="desktop-tool-title">Local Runtime MCP</h2>
        <p>让 StuDev 网页版和 Windows 版用上这台电脑里你授权的网页工具，也能体验在浏览器里运行的模型。下载包含运行时和浏览器扩展。</p>
      </div>
      <a class="download-button" href={runtimeRelease}>获取</a>
    </section>

    <p class="download-filing">App 备案号 <a href={PRODUCT_CONFIG.FILINGS.APP.URL} target="_blank" rel="noopener noreferrer">{PRODUCT_CONFIG.FILINGS.APP.TEXT}</a></p>
  </div>
</SiteLayout>
<script>
  // The big button is for the system one is on; the cards below keep every other way.
  const ua = navigator.userAgent;
  const id = /Android/i.test(ua) ? 'android' : /Windows/i.test(ua) ? 'windows' : 'web';
  const card = document.querySelector<HTMLElement>(`[data-client="${id}"]`);
  const source = card?.querySelector<HTMLAnchorElement>('.download-button');
  const primary = document.querySelector<HTMLAnchorElement>('[data-download-primary] .download-button');
  if (card && source && primary) {
    primary.href = source.href;
    primary.textContent = source.textContent;
    primary.rel = source.rel;
    const badge = card.querySelector<HTMLElement>('.client-badge');
    if (badge) badge.hidden = false;
    card.parentElement?.prepend(card);
  }
</script>
<style>
  .download-page {
    width: min(960px, calc(100% - 2 * var(--space-xl)));
    margin-inline: auto;
    padding-block: clamp(48px, 7vw, 96px) var(--space-xxl);
  }
  .download-hero { display: flex; flex-direction: column; align-items: center; text-align: center; margin-block-end: clamp(40px, 6vw, 64px); }
  .download-icon { width: 72px; height: 72px; border-radius: 18px; box-shadow: 0 6px 24px color-mix(in srgb, var(--brand) 22%, transparent); }
  h1 { margin: var(--space-l) 0 0; font-size: clamp(34px, 5vw, 48px); font-weight: 700; letter-spacing: -.04em; line-height: 1.15; }
  .download-hero > p { margin: var(--space-s) 0 0; color: var(--muted); font-size: clamp(15px, 1.6vw, 18px); }
  .download-primary { display: flex; flex-direction: column; align-items: center; gap: var(--space-s); margin-block-start: var(--space-xl); }
  .download-version { color: var(--faint); font-size: 12.5px; }
  .download-button {
    display: inline-grid;
    place-items: center;
    min-height: 40px;
    padding: 0 var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: background .15s, border-color .15s;
  }
  .download-button:hover { background: var(--surface-sunken); color: var(--ink); }
  .download-button.primary { min-height: 48px; padding: 0 32px; border-color: transparent; background: var(--brand); color: var(--on-brand); font-size: 16px; }
  .download-button.primary:hover { background: color-mix(in srgb, var(--brand) 88%, var(--ink)); color: var(--on-brand); }
  .download-clients { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  .download-client {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .client-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); }
  .client-badge { padding: 2px 8px; border-radius: var(--radius-pill); background: var(--surface-sunken); color: var(--muted); font-size: 11.5px; font-weight: 500; }
  .client-icon { width: 28px; height: 28px; fill: none; stroke: var(--brand); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .download-client h2 { margin: var(--space-m) 0 0; font-size: 19px; font-weight: 650; letter-spacing: -.02em; }
  .download-client p { flex: 1; margin: var(--space-xs) 0 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .client-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); margin-block-start: var(--space-l); }
  .client-foot small { color: var(--faint); font-size: 12.5px; }
  .download-support { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s) var(--space-l); margin-block-start: var(--space-l); font-size: 13px; }
  .download-support p { margin: 0; color: var(--muted); }
  .support-links { display: flex; flex-wrap: wrap; gap: var(--space-l); }
  .support-links a, .support-links .text-copy { padding: 0; border: 0; background: none; color: var(--brand); font: inherit; cursor: pointer; }
  .support-links a:hover, .support-links .text-copy:hover { text-decoration: underline; }
  .desktop-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    margin-block-start: clamp(40px, 6vw, 56px);
    padding: var(--space-l) var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .desktop-tool h2 { margin: 0; font-size: 16px; font-weight: 650; }
  .desktop-tool p { max-width: 60ch; margin: var(--space-xs) 0 0; color: var(--muted); font-size: 13.5px; }
  .download-filing { margin: var(--space-xl) 0 0; color: var(--faint); font-size: 12px; text-align: center; }
  .download-filing a { color: inherit; }
  @media (max-width: 760px) {
    .download-page { width: calc(100% - 2 * var(--space-l)); }
    .download-clients { grid-template-columns: 1fr; gap: var(--space-m); }
    .download-client { padding: var(--space-l); }
    .desktop-tool { flex-wrap: wrap; padding: var(--space-l); }
  }
</style>
