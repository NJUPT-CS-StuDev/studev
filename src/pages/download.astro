---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PRODUCT_CONFIG } from '../campus/app/config/product';
---
<SiteLayout title="下载 studev" hideFloatingPwa>
  <section class="download-page">
    <p class="download-eyebrow">校园服务，随身可用</p>
    <h1>studev Android</h1>
    <p>{PRODUCT_CONFIG.ANDROID_APP.SUMMARY}</p>
    <a class="download-button" href="/download/" aria-disabled="true" data-astro-prefetch="false" data-download-apk>正在准备下载…</a>
    <p class="download-status" data-download-status role="status">正在读取最新版本…</p>
    <progress data-download-progress aria-label="APK 下载进度" max="100" value="0" hidden></progress>
    <p class="download-help">下载后在浏览器的下载列表中打开 APK，按系统提示安装。微信、QQ 内请先选择「在浏览器中打开」。</p>
    <a href="/search/">iPhone 或其他设备 · 使用网页版 ↗</a>
    <noscript>请启用 JavaScript 后下载。</noscript>
  </section>
</SiteLayout>
<style>
  .download-page { max-width: 620px; margin: 64px auto; padding: 32px 24px; }
  .download-eyebrow { color: var(--brand); font-size: 14px; }
  h1 { font-size: clamp(32px, 6vw, 48px); letter-spacing: -.04em; margin: 16px 0; }
  .download-page p { line-height: 1.8; }
  .download-button { display: inline-block; padding: 14px 24px; margin-top: 24px; border-radius: 999px; background: var(--brand); color: var(--on-brand); text-decoration: none; }
  .download-button[aria-disabled] { opacity: .6; cursor: wait; }
  .download-status, .download-help { color: var(--muted); font-size: 14px; }
  progress { width: 100%; accent-color: var(--brand); }
  progress[hidden] { display: none; }
  .download-help { margin: 32px 0; }
</style>
<script>import '../download/client';</script>
