---
import SiteLayout from '../site/SiteLayout.astro';
import { PRODUCT_CONFIG } from '../campus/world/product';

const android = PRODUCT_CONFIG.ANDROID_APP;
const runtimeRelease = 'https://github.com/hicancan/local-runtime-mcp/releases/latest';
const clients = [
  {
    name: '网页版',
    description: '在手机或电脑的浏览器打开即用。',
    detail: '可添加到主屏幕',
    action: '打开网页版',
    href: '/',
  },
  {
    name: 'Android',
    description: '课表与地图支持离线查看，桌面小组件能显示下一节课。',
    detail: `APK · ${android.VERSION}`,
    action: '下载 Android 版',
    href: android.PACKAGE_URL,
    package: true,
  },
  {
    name: 'Windows',
    description: '支持自动更新，解压后打开 StuDev.exe。',
    detail: `x64 · ${android.VERSION}`,
    action: '下载 Windows 版',
    href: `/download/windows/studev-${android.VERSION}-windows.zip`,
    package: true,
  },
];
---
<SiteLayout title="获取 StuDev" description="在浏览器、Android 或 Windows 上使用 StuDev。下载 Local Runtime MCP，连接这台电脑上的网页工具。" active="download" noPwa>
  <div class="download-page">
    <header class="download-heading">
      <h1>获取 StuDev</h1>
      <p>课表、地图、知识、搜索和 AI 随时可用。</p>
    </header>

    <div class="download-clients">
      {clients.map(client => <article class="download-client">
        <h2>{client.name}</h2>
        <p>{client.description}</p>
        <small>{client.detail}</small>
        <a class="download-action" href={client.href} rel={client.package ? 'nofollow' : undefined} data-astro-prefetch={client.package ? 'false' : undefined}>{client.action}</a>
      </article>)}
    </div>

    <div class="download-support">
      <p>微信或 QQ 内下载 Android 版时，请先选择「在浏览器打开」。</p>
      <a href={android.BACKUP_URL} rel="nofollow" data-astro-prefetch="false">Android 备用下载</a>
      <a href={android.RELEASES_URL}>版本记录</a>
    </div>

    <section class="desktop-tools" aria-labelledby="desktop-tools-title">
      <h2 id="desktop-tools-title">桌面工具</h2>
      <div class="desktop-tool">
        <div>
          <h3>Local Runtime MCP</h3>
          <p>在 StuDev 网页版和 Windows 版使用这台电脑上已授权的网页工具，也能体验浏览器模型。下载包含运行时和浏览器扩展。</p>
        </div>
        <a class="download-action tool-action" href={runtimeRelease}>获取 Local Runtime MCP</a>
      </div>
    </section>

    <p class="download-filing">App 备案号 <a href={PRODUCT_CONFIG.FILINGS.APP.URL} target="_blank" rel="noopener noreferrer">{PRODUCT_CONFIG.FILINGS.APP.TEXT}</a></p>
  </div>
</SiteLayout>
<style>
  .download-page {
    width: min(920px, calc(100% - 2 * var(--space-xl)));
    margin-inline: auto;
    padding-block: clamp(54px, 6vw, 88px) var(--space-xxl);
  }
  .download-heading { margin-block-end: var(--space-xxl); }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 42px); font-weight: 650; letter-spacing: -.04em; line-height: 1.25; }
  .download-heading p { margin: var(--space-s) 0 0; color: var(--muted); font-size: 16px; }
  .download-clients { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  .download-client {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .download-client h2, .desktop-tool h3 { margin: 0; font-size: 21px; font-weight: 650; letter-spacing: -.025em; line-height: 1.35; }
  .download-client p, .desktop-tool p { margin: var(--space-s) 0 0; color: var(--muted); font-size: 14px; }
  .download-client p { flex: 1; }
  .download-client small { margin: var(--space-l) 0 var(--space-s); color: var(--muted); font-size: 12px; }
  .download-action {
    display: grid;
    place-items: center;
    min-height: var(--size-target);
    padding: var(--space-s) var(--space-l);
    border-radius: var(--radius-control);
    background: var(--brand-container);
    color: var(--on-brand-container);
    font-size: 14px;
    font-weight: 600;
    text-align: center;
  }
  .download-action:hover { background: color-mix(in srgb, var(--brand) 14%, var(--brand-container)); color: var(--on-brand-container); }
  .download-support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-l);
    margin-block-start: var(--space-l);
    font-size: 13px;
  }
  .download-support p { margin: 0; color: var(--muted); flex: 1 0 min(100%, 330px); }
  .download-support a { color: var(--brand); }
  .download-support a:hover, .download-filing a:hover { text-decoration: underline; }
  .desktop-tools { margin-block-start: 44px; }
  .desktop-tools h2 { margin: 0 0 var(--space-m); color: var(--muted); font-size: 14px; font-weight: 600; }
  .desktop-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    padding-block: var(--space-xl);
    border-block: 1px solid var(--line);
  }
  .desktop-tool h3 { font-size: 18px; }
  .desktop-tool p { max-width: 52ch; }
  .tool-action { flex: none; border: 1px solid var(--line); background: var(--paper); color: var(--ink); }
  .tool-action:hover { background: var(--surface); color: var(--ink); }
  .download-filing { margin: var(--space-xl) 0 0; color: var(--muted); font-size: 12px; }
  .download-filing a { color: inherit; }
  @media (max-width: 720px) {
    .download-page { width: calc(100% - 2 * var(--space-l)); }
    .download-heading { margin-block-end: var(--space-xl); }
    .download-clients { grid-template-columns: 1fr; gap: var(--space-m); }
    .download-client { padding: var(--space-l); }
    .desktop-tool { flex-wrap: wrap; }
  }
</style>
