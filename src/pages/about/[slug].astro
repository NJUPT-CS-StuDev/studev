---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('about', ({ data, id }) => data.status === 'published' && id !== 'studev');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={`${entry.data.title} — StuDev`} description={entry.data.description} active="about">
  <article class="detail-wrap">
    <a class="back-link" href="/about/">← About</a>
    <h1>{entry.data.title}</h1>
    <p class="article-description">{entry.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
