---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('about', ({ data, id }) => data.status === 'published' && id !== 'studev');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={`${entry.data.title} — StuDev`} description={entry.data.description} active="about">
  <article class="detail-wrap">
    <a class="back-link" href="/about/">← About</a>
    {entry.data.kicker ? (
      <p class="eyebrow article-kicker">{entry.data.kicker}</p>
    ) : (
      <p class="eyebrow article-kicker">About · 组织回响</p>
    )}
    <h1>{entry.data.title}</h1>
    {(entry.data.pubDate || entry.data.author) && (
      <div class="article-meta">
        {entry.data.pubDate && <span>发布于 {entry.data.pubDate}</span>}
        {entry.data.author && <span>· 作者：{entry.data.author}</span>}
      </div>
    )}
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="article-tags">
        {entry.data.tags.map((tag: string) => <span class="tag-badge">#{tag}</span>)}
      </div>
    )}
    <p class="article-description">{entry.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
