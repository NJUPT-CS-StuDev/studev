---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/collection.css';
---
<SiteLayout title="历史收件 — StuDev" noindex={true}>
  <div class="collection-page" data-legacy-collection>
    <header class="collection-header"><p class="eyebrow">STUDEV · 历史记录</p><h1>历史收件</h1><p class="collection-intro">升级前的材料保留在此，仅管理人员可查看和下载。新的收集需求请在统一管理台创建表单。</p><p><a href="/admin/">← 返回管理台</a></p></header>
    <div class="collection-status" role="status" aria-live="polite" data-legacy-status>正在验证管理权限……</div>
    <section class="collection-card" data-legacy-list hidden><h2>升级前的提交</h2><div data-legacy-items></div></section>
  </div>
  <script>import '../scripts/platform-legacy';</script>
</SiteLayout>
