---
import { getCollection } from 'astro:content';
import SiteLayout from '../../site/SiteLayout.astro';
import HistoryTermView from '../../site/history/HistoryTermView.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('history', ({ data }) => data.status === 'published'))
    .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props;
---
<SiteLayout title={`${entry.data.title} · 历史 — StuDev`} description={entry.data.description} active="history">
  <HistoryTermView entry={entry} allEntries={entries} />
</SiteLayout>
