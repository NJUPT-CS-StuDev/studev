---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EventTimeline from '../../components/history/EventTimeline.astro';
export async function getStaticPaths() {
  const entries = await getCollection('history', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const term = entry.data.term || entry.id;
const skeletonGroups = [
  { name: '主席团与统筹', count: 4, featured: true },
  { name: '运营支持部', count: 3, featured: false },
  { name: '易班建设部', count: 3, featured: false },
  { name: '媒体宣传部', count: 3, featured: false },
  { name: '心理工作部', count: 4, featured: false },
];
---
<SiteLayout title={`${entry.data.title} — StuDev`} description={entry.data.description} active="history">
  <article class="term-page">
    <a class="back-link" href="/history/">← History</a>
    <header class="term-header">
      <p class="eyebrow">历届档案</p>
      <h1>{entry.data.title}</h1>
      <p>南邮计软网安学生发展中心</p>
      <nav class="term-nav" aria-label="本届页面导航"><a href="#people">成员</a><a href="#events">大事记</a></nav>
    </header>

    <section class="term-section" id="people" aria-labelledby="people-title" data-roster-term={term}>
      <div class="term-section-heading"><span class="section-number">01</span><h2 id="people-title">成员</h2><span class="section-aside" data-roster-count>17 人</span></div>
      <div data-roster-container>
        {skeletonGroups.map((group, gIdx) => (
          <section class="member-group" aria-labelledby={`skeleton-group-${gIdx}`}>
            <h3 id={`skeleton-group-${gIdx}`}>{group.name}</h3>
            <div class="member-grid">
              {Array.from({ length: group.count }).map(() => (
                <article class:list={['member', 'member-skeleton', { 'member-featured': group.featured }]} aria-hidden="true">
                  <div class="member-avatar skeleton-circle"></div>
                  <div class="member-copy">
                    <div class="skeleton-line skeleton-name"></div>
                    <div class="skeleton-line skeleton-sig"></div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="term-section" id="events" aria-labelledby="events-title">
      <div class="term-section-heading"><span class="section-number">02</span><h2 id="events-title">大事记</h2><span class="section-aside">{entry.data.events.length} 个节点</span></div>
      <EventTimeline events={entry.data.events} />
    </section>

    <section class="term-section term-narrative" aria-label="本届纪事">
      <div class="prose"><Content /></div>
    </section>
  </article>
  <script>import '../../scripts/history-roster';</script>
</SiteLayout>
