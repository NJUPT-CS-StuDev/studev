---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EventTimeline from '../../components/history/EventTimeline.astro';
export async function getStaticPaths() {
  const entries = await getCollection('history', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const term = entry.data.term || entry.id;
---
<SiteLayout title={`${entry.data.title} — StuDev`} description={entry.data.description} active="history">
  <article class="term-page">
    <a class="back-link" href="/history/">← History</a>
    <header class="term-header">
      <p class="eyebrow">历届档案</p>
      <h1>{entry.data.title}</h1>
      <p>南邮计软网安学生发展中心</p>
      <nav class="term-nav" aria-label="本届页面导航"><a href="#people">成员</a><a href="#events">大事记</a></nav>
    </header>

    <section class="term-section" id="people" aria-labelledby="people-title" data-roster-term={term}>
      <div class="term-section-heading"><span class="section-number">01</span><h2 id="people-title">成员</h2><span class="section-aside" data-roster-count>加载中…</span></div>
      <div data-roster-container>
        <p style="padding: 28px 0; color: var(--muted); font-size: .9rem;">正在同步本届成员名册…</p>
      </div>
    </section>

    <section class="term-section" id="events" aria-labelledby="events-title">
      <div class="term-section-heading"><span class="section-number">02</span><h2 id="events-title">大事记</h2><span class="section-aside">{entry.data.events.length} 个节点</span></div>
      <EventTimeline events={entry.data.events} />
    </section>

    <section class="term-section term-narrative" aria-label="本届纪事">
      <div class="prose"><Content /></div>
    </section>
  </article>
  <script>import '../../scripts/history-roster';</script>
</SiteLayout>
