---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HistoryTermView from '../../components/history/HistoryTermView.astro';

const entries = (await getCollection('history'))
  .filter((item) => item.data.status === 'published')
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const currentEntry = entries.find((item) => item.id === '2026-2027') ?? entries[0];
---
<SiteLayout title="History — StuDev" description={currentEntry.data.description} active="history">
  <HistoryTermView entry={currentEntry} allEntries={entries} />
</SiteLayout>
