---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('develop', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={`${entry.data.title} — StuDev`} description={entry.data.description} active="develop">
  <article class="detail-wrap">
    <a class="back-link" href="/develop/">← Develop</a>
    {entry.data.kicker ? (
      <p class="eyebrow article-kicker">{entry.data.kicker}</p>
    ) : (
      <p class="eyebrow article-kicker">Develop · 研发工程</p>
    )}
    <h1>{entry.data.title}</h1>
    {(entry.data.pubDate || entry.data.author) && (
      <div class="article-meta">
        {entry.data.pubDate && <span>发布于 {entry.data.pubDate}</span>}
        {entry.data.author && <span>· 作者：{entry.data.author}</span>}
      </div>
    )}
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="article-tags">
        {entry.data.tags.map((tag: string) => <span class="tag-badge">#{tag}</span>)}
      </div>
    )}
    <p class="article-description">{entry.data.description}</p>
    <div class="project-actions">
      {entry.data.demo && (
        <a class="project-btn project-btn-primary" href={entry.data.demo} target="_blank" rel="noopener noreferrer">在线使用 ↗</a>
      )}
      <a class="project-btn project-btn-secondary" href={entry.data.repository} target="_blank" rel="noopener noreferrer">GitHub 源码 ↗</a>
    </div>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
