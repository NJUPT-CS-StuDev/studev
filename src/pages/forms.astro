---
import SiteLayout from '../site/SiteLayout.astro';
import Workspace from '../platform/client/collections/Workspace';
import CollectionEntry from '../platform/client/collections/Entry';
import PlatformStartup from '../platform/client/PlatformStartup.astro';
import styles from '../platform/client/collections/workspace.css?inline';
---
<SiteLayout title="收集 — StuDev" description="StuDev 的课程作业、活动报名和资料收集" active="forms" noindex={true}>
  <Fragment slot="head">
    <style is:inline set:html={styles}></style>
    <PlatformStartup surface="collections" />
  </Fragment>
  <Workspace client:only="react">
    <div slot="fallback" class="cw-workspace">
      <div class="cw-workspace-toolbar cw-entry-title"><h1>收集</h1></div>
      <CollectionEntry />
      <p class="cw-loading" role="status"><span class="cw-spinner"></span>正在加载收集…</p>
    </div>
  </Workspace>
  <noscript><p>请开启 JavaScript 以使用收集。</p></noscript>
</SiteLayout>
