---
import PlatformShell from '../components/PlatformShell.astro';
---
<PlatformShell title="表单" active="forms">
  <header class="p-heading"><div><h1>全部表单</h1><p>浏览并填写中心当前开放的内部登记、资料收集与反馈表单。</p></div></header>
  <div class="p-toolbar"><input class="p-input" id="form-search" type="search" placeholder="搜索表单" data-forms-search /><span class="p-count" data-forms-count></span></div>
  <div class="p-message" role="status" aria-live="polite" data-forms-status></div>
  <div class="p-list" data-forms-list></div>
  <script>import '../client/platform/platform-forms';</script>
</PlatformShell>
