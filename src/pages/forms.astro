---
import SiteLayout from '../site/SiteLayout.astro';
import Workspace from '../platform/client/collections/Workspace';
import '../platform/client/collections/workspace.css';
---
<SiteLayout title="收集 — StuDev" description="StuDev 的课程作业、活动报名和资料收集" active="forms" noindex={true}>
  <Workspace client:only="react">
    <div slot="fallback" class="cw-workspace" aria-busy="true"><div class="cw-workspace-toolbar"><h1>收集</h1></div><p class="cw-loading"><span class="cw-spinner"></span>正在加载收集…</p></div>
  </Workspace>
  <noscript><p>请开启 JavaScript 以使用收集。</p></noscript>
</SiteLayout>
