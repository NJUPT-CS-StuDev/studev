---
import SiteLayout from '../../site/SiteLayout.astro';
import SearchApp from '../../campus/search/SearchApp';
import product from '../../../product.json';
import release from '../../data/campus-release.json';
import { searchBootstrap } from '../../site/build/search-preload.mjs';

const { base: searchBase, manifest } = searchBootstrap(release, import.meta.env.DEV ? Astro.url.origin : product.campusOrigin, !import.meta.env.DEV);
---
<SiteLayout title="搜索 — StuDev" description="搜南京邮电大学的课程、老师、班级、教室、地点、通知和学习资料。" active="search">
  <link slot="head" rel="preconnect" href={product.campusOrigin} crossorigin="anonymous" />
  <script slot="head" is:inline type="application/json" data-search-base={searchBase} set:html={JSON.stringify(manifest).replaceAll('<', '\\u003c')} />
  <Fragment slot="head">
    <script>
      import { warmSearch } from '../../campus/world/search';
      warmSearch();
    </script>
  </Fragment>
  <SearchApp client:only="react" />
</SiteLayout>
