---
import SiteLayout from '../site/SiteLayout.astro';
import '../platform/platform.css';
---
<SiteLayout title="登录 — StuDev" active="login" noindex={true}>
  <div class="platform">
    <section class="p-card p-auth">
      <h1>登录</h1>
      <div class="p-tabs p-auth-tabs" role="tablist" aria-label="账号操作">
        <button class="p-tab" id="login-tab" type="button" role="tab" aria-selected="true" aria-controls="login-panel" data-auth-tab="login">登录</button>
        <button class="p-tab" id="register-tab" type="button" role="tab" aria-selected="false" aria-controls="register-panel" data-auth-tab="register">注册账号</button>
      </div>
      <div class="p-message" role="status" aria-live="polite" data-auth-status></div>
      <form id="login-panel" role="tabpanel" aria-labelledby="login-tab" data-login-form>
        <div class="p-field">
          <label for="login-student-id">学号</label>
          <input id="login-student-id" name="studentId" pattern="[A-Za-z0-9]{6,20}" minlength="6" maxlength="20" autocomplete="username" autocapitalize="characters" spellcheck="false" placeholder="你的学号" required />
        </div>
        <div class="p-field">
          <label for="login-password">密码</label>
          <div class="p-password-wrap">
            <input id="login-password" name="password" type="password" maxlength="256" autocomplete="current-password" placeholder="请输入密码" required />
            <button class="p-password-toggle" type="button" aria-label="显示密码" data-toggle-password></button>
          </div>
        </div>
        <div class="p-field" data-login-totp hidden>
          <label for="login-totp">双重验证码</label>
          <input id="login-totp" name="totp" autocomplete="one-time-code" maxlength="64" placeholder="6 位动态码或恢复码" />
        </div>
        <button class="p-button wide" type="submit">立即登录</button>
        <details style="margin-top:16px" data-forgot><summary class="p-help">忘记密码？</summary>
          <p class="p-help">在上面填好学号，点下面的按钮，重设链接会发到这个账号绑定的 QQ 邮箱，30 分钟内有效。</p>
          <button class="p-button secondary" type="button" data-forgot-send>发送重设链接</button>
        </details>
      </form>
      <form data-reset-form hidden>
        <p class="p-help">为你的账号设置新密码。设置后，所有设备都会退出登录。</p>
        <div class="p-field">
          <label for="reset-password">新密码</label>
          <div class="p-password-wrap">
            <input id="reset-password" name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" placeholder="至少 12 位密码" required />
            <button class="p-password-toggle" type="button" aria-label="显示密码" data-toggle-password></button>
          </div>
        </div>
        <div class="p-field">
          <label for="reset-confirm">确认新密码</label>
          <div class="p-password-wrap">
            <input id="reset-confirm" name="confirm" type="password" minlength="12" maxlength="256" autocomplete="new-password" placeholder="再次输入新密码" required />
            <button class="p-password-toggle" type="button" aria-label="显示密码" data-toggle-password></button>
          </div>
        </div>
        <button class="p-button wide" type="submit">设置新密码</button>
      </form>
      <form data-delete-form hidden>
        <p class="p-help">确认后，你的账号、学号绑定和所有登录设备会立即删除，无法恢复。</p>
        <button class="p-button wide danger" type="submit">确认注销账号</button>
      </form>
      <form id="register-panel" role="tabpanel" aria-labelledby="register-tab" data-register-form hidden>
        <div class="p-field">
          <label for="register-student-id">学号</label>
          <input id="register-student-id" name="studentId" pattern="[A-Za-z0-9]{6,20}" minlength="6" maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="你的学号" required />
        </div>
        <div class="p-field">
          <label for="register-real-name">姓名</label>
          <input id="register-real-name" name="realName" maxlength="40" autocomplete="name" placeholder="真实姓名" required />
        </div>
        <div class="p-field">
          <label for="register-nickname">昵称</label>
          <input id="register-nickname" name="nickname" maxlength="40" autocomplete="nickname" placeholder="其他同学看到的名字" required />
          <p class="p-help">普通账号对其他同学仅显示昵称，身份资料仅本人和管理员可见。</p>
        </div>
        <div class="p-field">
          <label for="register-qq">联系 QQ</label>
          <div class="p-input-suffix-wrap">
            <input id="register-qq" name="qq" inputmode="numeric" pattern="[1-9][0-9]{4,11}" maxlength="12" autocomplete="off" placeholder="常用 QQ 号" required />
            <span class="p-input-suffix">@qq.com</span>
          </div>
          <div class="p-qq-preview" data-qq-preview hidden></div>
          <p class="p-help" data-qq-email>用于重要通知、找回密码、注销验证与匹配 QQ 头像</p>
        </div>
        <div class="p-field">
          <label for="register-password">设置密码</label>
          <div class="p-password-wrap">
            <input id="register-password" name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" placeholder="至少 12 位密码" required />
            <button class="p-password-toggle" type="button" aria-label="显示密码" data-toggle-password></button>
          </div>
        </div>
        <div class="p-field">
          <label for="register-confirm">确认密码</label>
          <div class="p-password-wrap">
            <input id="register-confirm" name="confirm" type="password" minlength="12" maxlength="256" autocomplete="new-password" placeholder="再次输入密码" required />
            <button class="p-password-toggle" type="button" aria-label="显示密码" data-toggle-password></button>
          </div>
        </div>
        <label class="p-checkbox" style="margin-bottom:18px;align-items:flex-start">
          <input id="register-agreements" name="agreements" type="checkbox" style="margin-top:4px" required />
          <span>我已阅读并同意 <a class="p-link" href="/terms/" target="_blank" rel="noopener">《用户协议》</a> 与 <a class="p-link" href="/privacy/" target="_blank" rel="noopener">《隐私政策》</a>，承诺不使用学校统一身份认证密码。</span>
        </label>
        <button class="p-button wide" type="submit">立即注册</button>
      </form>
    </section>
  </div>
  <script>import '../platform/client/login';</script>
</SiteLayout>
