---
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string; }
const { title = 'StuDev', description = '南京邮电大学计软网安学生发展中心。', active = '' } = Astro.props;
const nav = [
  { href: '/study/', label: 'Study', key: 'study' },
  { href: '/develop/', label: 'Develop', key: 'develop' },
  { href: '/life/', label: 'Life', key: 'life' },
  { href: '/history/', label: 'History', key: 'history' },
  { href: '/about/', label: 'About', key: 'about' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="StuDev 首页"><img src="/logo.png" alt="" width="48" height="48" /></a>
        <nav class="site-nav" aria-label="主导航">{nav.map((item) => <a class:list={[{ active: active === item.key }]} href={item.href}>{item.label}</a>)}</nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><span>© {new Date().getFullYear()} StuDev</span><a href="https://github.com/NJUPT-CS-StuDev/studev" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></footer>
    <script>import '../scripts/diagrams';</script>
  </body>
</html>
