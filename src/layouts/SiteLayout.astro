---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import tokens from '../../design/tokens.json';
import PwaPanel from '../pwa/PwaPanel.astro';
import { PRODUCT_CONFIG } from '../campus/app/config/product';
// fill: the page is one full-height application (the map) with no footer.
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; fill?: boolean; hideFloatingPwa?: boolean; }
const { title = 'StuDev', description = '南京邮电大学计软网安学生发展中心。', active = '', noindex = false, fill = false, hideFloatingPwa = false } = Astro.props;
const nav = [
  { href: '/study/', label: 'Study', key: 'study' },
  { href: '/develop/', label: 'Develop', key: 'develop' },
  { href: '/life/', label: 'Life', key: 'life' },
  { href: '/history/', label: 'History', key: 'history' },
  { href: '/about/', label: 'About', key: 'about' },
];
const favicon = await getImage({ src: logo, width: 48, height: 48, format: 'png' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const initialSearchRoute = normalizedPath === '/search'
  ? 'home'
  : active === 'search'
    ? 'subpage'
    : undefined;
const initialSearchPlaceholder =
  normalizedPath === '/search/classrooms'
    ? '搜索校区、楼栋或教室'
    : normalizedPath === '/search/timetable'
      ? '搜索班级、课程或教师'
      : normalizedPath === '/search/exam'
        ? '搜索班级或考试课程'
        : normalizedPath === '/search/community'
          ? '搜索南邮生存手册'
          : normalizedPath === '/search/materials'
            ? '搜索历年课程资料'
            : normalizedPath === '/search/web'
              ? '搜索校内通知与公告'
              : '搜通知、课表、考场、资料…';
---
<!doctype html>
<html lang="zh-CN" data-search-route={initialSearchRoute}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={tokens.color.light.paper} data-light={tokens.color.light.paper} data-dark={tokens.color.dark.paper} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/pwa-icons/180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="studev" />
    <script is:inline>
      // Signed-in people see their member links from the first frame.
      try { if (localStorage.getItem('studev_auth_user')) document.documentElement.dataset.member = ''; } catch { /* Storage may be unavailable. */ }
      let preference;
      try { preference = localStorage.getItem('site-theme'); } catch { /* Storage may be unavailable. */ }
      const theme = preference === 'light' || preference === 'dark'
        ? preference
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      themeMeta?.setAttribute('content', themeMeta.getAttribute(`data-${theme}`));
    </script>
    <meta name="description" content={description} />
    {Astro.url.pathname === '/' && <meta name="baidu-site-verification" content="codeva-J4MgSBcNRe" />}
    {Astro.url.pathname === '/' && <meta name="msvalidate.01" content="E44C2F6A09F0A678DED98C8374E549A1" />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={favicon.src} />
    {(active === 'history' || active === 'account' || active === 'forms') && <link rel="preconnect" href="https://q1.qlogo.cn" crossorigin />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', Astro.site)} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="StuDev 首页"><Image src={logo} alt="" width={56} height={56} densities={[1, 2, 3]} loading="eager" decoding="async" /></a>
        <div class="header-search" data-header-search>
          <form class="header-search-form" action="/search/" method="get" role="search" data-header-search-form>
            <a class="header-search-icon-link" href="/search/" aria-label="前往 studev-search 首页" title="studev-search 首页">
              <svg class="header-search-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </a>
            <input
              class="header-search-input"
              type="text"
              name="q"
              placeholder={initialSearchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              aria-label="studev-search 全站校园搜索"
              data-header-search-input
            />
            <button class="header-search-clear" type="button" aria-label="清空搜索" hidden data-header-search-clear>×</button>
            <kbd class="header-search-kbd" aria-hidden="true">/</kbd>
          </form>
          <div class="header-search-panel" aria-label="studev-search 快捷入口">
            <div class="header-search-panel-head">
              <span class="header-search-brand">studev<span>-search</span></span>
              <a class="header-search-home" href="/search/">聚合主页 →</a>
            </div>
            <div class="header-search-grid">
              <a href="/search/timetable/">📅 课表</a>
              <a href="/search/classrooms/">🏫 空教室</a>
              <a href="/search/exam/">📝 考试安排</a>
              <a href="/search/web/">🌐 校内通知</a>
              <a href="/search/community/">📖 生存手册</a>
              <a href="/search/materials/">📚 历年资料</a>
            </div>
          </div>
        </div>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => <a class:list={[{ active: active === item.key }]} href={item.href}>{item.label}</a>)}
          <a class:list={[{ active: active === 'forms' }]} href="/forms/" data-member-link hidden>Forms</a>
        </nav>
        <a class:list={['nav-account', { active: active === 'account' || active === 'login' }]} href="/account/" data-global-account-link>Account</a>
        <ThemeToggle />
      </div>
    </header>
    <main class:list={[fill && 'main-fill']}><slot /></main>
    {!fill && <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-meta">
          <a class="footer-badge-link" href="https://visitor-badge.laobi.icu" target="_blank" rel="noopener noreferrer" title="全站访问量统计（visitor-badge）">
            <img
              class="visitor-badge"
              src={PRODUCT_CONFIG.VISITOR_BADGE_URL}
              srcset={`${PRODUCT_CONFIG.VISITOR_BADGE_URL} 1x`}
              alt="全站访问量"
              width="86"
              height="20"
              loading="lazy"
              decoding="async"
            />
          </a>
          <span class="footer-dot" aria-hidden="true">·</span>
          <span>© {new Date().getFullYear()} StuDev</span>
        </div>
        <div class="footer-actions">
          <a class="text-copy pwa-footer-entry" href={PRODUCT_CONFIG.ANDROID_APP.DOWNLOAD_URL} data-pwa-open aria-haspopup="dialog" title={`studev Android ${PRODUCT_CONFIG.ANDROID_APP.VERSION}：${PRODUCT_CONFIG.ANDROID_APP.SUMMARY}`}>下载 App</a>
          <span class="footer-dot" aria-hidden="true">·</span>
          <button class="text-copy" type="button" data-copy-link title="复制当前页面网址，便于转发"><span aria-live="polite" data-copy-label>{Astro.url.pathname === '/' ? '分享网站' : '分享本页'}</span></button>
          <span class="footer-dot" aria-hidden="true">·</span>
          <a class="footer-github-badge" href={PRODUCT_CONFIG.GITHUB_REPO} target="_blank" rel="noopener noreferrer" title="访问 GitHub 开源仓库">
            <svg class="github-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
            <span>GitHub</span>
            <span class="github-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </footer>}
    <PwaPanel floating={fill && !hideFloatingPwa} />
    <script>import '../client/site/copy-text';</script>
    <script>import '../client/site/diagrams';</script>
    <script>import '../client/platform/auth-status';</script>
    <script>import '../client/site/header-search';</script>
  </body>
</html>
