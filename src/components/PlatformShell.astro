---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/platform.css';
interface Props { title: string; description?: string; active?: string; }
const {title, description = 'StuDev 表单与信息登记', active = ''} = Astro.props;
---
<SiteLayout title={`${title} — StuDev`} description={description} active="forms" noindex={true}>
  <script is:inline>
    // 0ms 瞬间拦截：若客户端本地无登录态，在首帧 DOM 渲染前直接重定向至登录页，杜绝加载延迟
    try {
      if (!localStorage.getItem('studev_auth_user')) {
        location.replace('/login/?next=' + encodeURIComponent(location.pathname + location.search));
      }
    } catch {}
  </script>
  <div class="platform">
    <nav class="p-nav" aria-label="表单导航">
      <div class="p-nav-group">
        <a href="/forms/" aria-current={active === 'forms' ? 'page' : undefined}>全部表单</a>
        <a href="/submissions/" aria-current={active === 'submissions' ? 'page' : undefined}>我的提交</a>
        <a href="/admin/" data-platform-staff hidden aria-current={active === 'admin' ? 'page' : undefined}>表单管理</a>
      </div>
    </nav>
    <noscript><p class="p-message" data-kind="error">此功能需要启用 JavaScript。</p></noscript>
    <slot />
  </div>
  <script>import '../scripts/platform-nav';</script>
</SiteLayout>
