---
import SiteLayout from '../layouts/SiteLayout.astro';
import fragments from '../data/search-fragments.json';

interface Props {
  route: 'home' | 'search' | 'community' | 'materials' | 'exam' | 'timetable' | 'classrooms';
}

const { route } = Astro.props;
const routeData = fragments.routes[route];
---
<SiteLayout title={routeData.title} description={routeData.description} active="search">
  <link slot="head" rel="stylesheet" crossorigin href={fragments.cssHref} />
  <script slot="head" type="module" crossorigin src={fragments.jsHref} is:inline></script>
  <div id="root" set:html={routeData.html} />
</SiteLayout>
