---
import './global.css';
import MeApp from '../campus/me/MeApp';
import { getImage, Image } from 'astro:assets';
import logo from '../assets/logo.png';
import policeEmblem from '../assets/police-emblem.png';
import tokens from '../../design/tokens.json';
import PwaPanel from '../pwa/PwaPanel.astro';
import { PRODUCT_CONFIG } from '../campus/world/product';
import { ClientRouter } from 'astro:transitions';
// fill: the page is one full-height application (the map) with no footer.
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; fill?: boolean; noPwa?: boolean; }
const { title = PRODUCT_CONFIG.APP_NAME, description = PRODUCT_CONFIG.POSITIONING, active = '', noindex = false, fill = false, noPwa = false } = Astro.props;
const personalMenu = active !== 'login';
const campusHeader = ['timetable', 'knowledge', 'search', 'ai'].includes(active);
// The five app pages swap in place, so an answer the AI is writing goes on while one looks at the timetable or map.
const appPage = ['timetable', 'map', 'knowledge', 'search', 'ai'].includes(active);
const tabs = [
  { href: '/', label: '课表', key: 'timetable' },
  { href: '/map/', label: '地图', key: 'map' },
  { href: '/knowledge/', label: '知识', key: 'knowledge' },
  { href: '/search/', label: '搜索', key: 'search' },
  { href: '/ai/', label: 'AI', key: 'ai' },
] as const;
const clubKeys = ['club', 'study', 'develop', 'life', 'history'];
const clubNav = [
  { href: '/study/', label: '学习', key: 'study' },
  { href: '/develop/', label: '开发', key: 'develop' },
  { href: '/life/', label: '生活', key: 'life' },
  { href: '/history/', label: '历史', key: 'history' },
];
const favicon = await getImage({ src: logo, width: 48, height: 48, format: 'png' });
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={tokens.color.light.paper} data-light={tokens.color.light.paper} data-dark={tokens.color.dark.paper} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/pwa-icons/180.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={PRODUCT_CONFIG.APP_NAME} />
    <script is:inline>
      // Signed-in people see their member links from the first frame.
      try { if (localStorage.getItem('studev_auth_user')) document.documentElement.dataset.authenticated = ''; } catch { /* Storage may be unavailable. */ }
      let preference;
      // The appearance is one of the parts of oneself kept in studev_prefs (preferences.ts), applied before first paint.
      try { preference = JSON.parse(localStorage.getItem('studev_prefs') ?? '{}')?.appearance; } catch { /* Storage may be unavailable or the record unreadable. */ }
      const root = document.documentElement;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const paint = theme => {
        root.dataset.theme = theme;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        themeMeta?.setAttribute('content', themeMeta.getAttribute(`data-${theme}`));
      };
      root.dataset.appearance = preference === 'light' || preference === 'dark' ? preference : 'auto';
      paint(root.dataset.appearance === 'auto' ? (system.matches ? 'dark' : 'light') : root.dataset.appearance);
      system.addEventListener('change', () => {
        if (root.dataset.appearance !== 'auto') return;
        paint(system.matches ? 'dark' : 'light');
        document.dispatchEvent(new CustomEvent('site:theme-change'));
      });
    </script>
    <meta name="description" content={description} />
    {Astro.url.pathname === '/' && <meta name="baidu-site-verification" content="codeva-J4MgSBcNRe" />}
    {Astro.url.pathname === '/' && <meta name="msvalidate.01" content="E44C2F6A09F0A678DED98C8374E549A1" />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={favicon.src} />
    {(active === 'history' || active === 'account' || active === 'forms') && <link rel="preconnect" href="https://q1.qlogo.cn" crossorigin />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', Astro.site)} />
    <script is:inline>
      // A same-page panel can consume Back before the page router sees it.
      window.addEventListener('popstate', (event) => {
        const local = new PopStateEvent('studev:before-popstate', { state: event.state, cancelable: true });
        if (!window.dispatchEvent(local)) event.stopImmediatePropagation();
      });
    </script>
    {appPage && <ClientRouter fallback="swap" />}
    <slot name="head" />
    <title>{title}</title>
    {/* What a link to this page looks like when shared, in WeChat and elsewhere: an opaque square image, since
        transparent corners are drawn black there, and the page's own title and description. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_CONFIG.APP_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/pwa-icons/512.png', Astro.site)} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label={`${PRODUCT_CONFIG.APP_NAME} 首页`}>{PRODUCT_CONFIG.APP_NAME}</a>
        <nav class="site-nav" aria-label="主导航">
          {tabs.map((item) => <a class:list={['campus-tab', { active: active === item.key }]} href={item.href} aria-current={active === item.key ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tokens.glyph[item.key]} /></svg><span>{item.label}</span></a>)}
          <a class:list={[{ active: clubKeys.includes(active) }]} href="/club/">学生发展中心</a>
          <a class:list={[{ active: active === 'forms' }]} href="/forms/" data-account-link hidden>表单</a>
        </nav>
        <button class="theme-entry" type="button" data-theme-toggle aria-label="切换外观"><svg class="theme-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" /></svg><svg class="theme-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.6" /><path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M5.6 18.4l1.6-1.6M16.8 7.2l1.6-1.6" /></svg><svg class="theme-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A7.8 7.8 0 0 1 9.5 4.5a7.8 7.8 0 1 0 10 10Z" /></svg></button>
        <button class="site-share-entry" type="button" data-share-studev aria-label="分享 StuDev"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tokens.glyph.share} /></svg><span>分享</span></button>
        <a class="app-entry" href={PRODUCT_CONFIG.ANDROID_APP.DOWNLOAD_URL} aria-current={active === 'download' ? 'page' : undefined}>下载</a>
        {personalMenu && <span class:list={['site-account', { 'campus-site-account': campusHeader }]}><MeApp campus={campusHeader} client:only="react"><span slot="fallback" class="avatar avatar-loading" role="status" aria-label="正在加载个人菜单" aria-busy="true"><span class="avatar-face"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6" /><path d="M5 20c.8-3.8 3.6-5.8 7-5.8s6.2 2 7 5.8" /></svg></span><span class="avatar-name">加载中</span></span></MeApp></span>}
      </div>
      {clubKeys.includes(active) && <nav class="club-nav" aria-label="学生发展中心栏目">{clubNav.map((item) => <a class:list={[{ active: active === item.key }]} href={item.href}>{item.label}</a>)}</nav>}
    </header>
    <main class:list={[fill && 'main-fill']}><slot /></main>
    {appPage && <div id="ai-host" class="ai-host" transition:persist="ai-host" hidden></div>}
    {!fill && <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-copy">© {new Date().getFullYear()} <a href="/about/" aria-label="关于 StuDev">{PRODUCT_CONFIG.APP_NAME}</a></span>
        {/* The filings sit at the centre of the foot, where the rules put them and where the footer balances. */}
        <span class="filings">
          <a href={PRODUCT_CONFIG.FILINGS.ICP.URL} target="_blank" rel="noopener noreferrer">{PRODUCT_CONFIG.FILINGS.ICP.TEXT}</a>
          <a href={PRODUCT_CONFIG.FILINGS.POLICE.URL} target="_blank" rel="noopener noreferrer"><Image src={policeEmblem} width={14} height={15} densities={[1, 2, 3]} alt="" />{PRODUCT_CONFIG.FILINGS.POLICE.TEXT}</a>
          <a href="/terms/">用户协议</a>
          <a href="/privacy/">隐私政策</a>
        </span>
        <a class="footer-code" href={PRODUCT_CONFIG.GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>}
    {!noPwa && !fill && <aside class="app-offer" data-app-offer hidden>
      <a href={PRODUCT_CONFIG.ANDROID_APP.DOWNLOAD_URL}><b>安卓 App</b> 桌面小组件，下一节课在哪一眼看到</a>
      <button type="button" aria-label="不再显示" data-app-offer-close>×</button>
    </aside>}
    <nav class="phone-tabs" aria-label="主导航">
      {tabs.map((item) => <a class:list={['campus-tab', { active: active === item.key }]} href={item.href} aria-current={active === item.key ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tokens.glyph[item.key]} /></svg><span>{item.label}</span></a>)}
    </nav>
    <dialog class="site-share" id="share-studev" aria-labelledby="share-studev-title">
      <form method="dialog">
        <div class="site-share-head"><h2 id="share-studev-title">分享 StuDev</h2><button type="submit" aria-label="关闭">×</button></div>
        <input readonly aria-label="StuDev 官网链接" value={`${PRODUCT_CONFIG.ORIGIN}/`} />
        <button type="button" data-copy-share>复制链接</button>
        <span data-share-status role="status"></span>
      </form>
    </dialog>
    {!noPwa && <PwaPanel floating={false} />}
    <script>import './app-offer';</script>
    <script>import './copy-text';</script>
    <script>import './share';</script>
    <script>import './theme-toggle';</script>
    <script>import '../platform/client/auth-status';</script>
    {appPage && <script>import '../campus/ai/host';</script>}
    {active !== 'download' && active !== 'login' && active !== 'search' && <script>import { warmSearch } from '../campus/world/search'; warmSearch();</script>}
  </body>
</html>
